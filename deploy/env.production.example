# /opt/personal-quartermaster/.env  (create with: umask 077; mode must be 600)
# Every variable the stack reads. No values here: the owner fills them in on the server.
# Never paste these values into a chat, the repository, shell history or CI logs.

# ── Cloudflare ──────────────────────────────────────────────────────────────
# Token of the tunnel "personal-quartermaster" (Zero Trust → Networks → Tunnels).
TUNNEL_TOKEN=
# Team domain, e.g. <team>.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application audience (AUD) tag of the self-hosted Access application.
CF_ACCESS_AUD=

# ── Database ────────────────────────────────────────────────────────────────
# Long random password, used by the db container on first start.
POSTGRES_PASSWORD=
# postgres://pq:<POSTGRES_PASSWORD>@db:5432/pq  (URL-encode special characters)
DATABASE_URL=

# ── AI (from M3) ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Monthly cap in USD; background jobs stop when it is reached.
AI_BUDGET_USD_MONTH=
# Model ids per purpose (see the Anthropic docs for current ids).
AI_MODEL_EXTRACT=
AI_MODEL_REASON=

# ── Receipt mailbox (from M4) ───────────────────────────────────────────────
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# ── Outgoing mail for the digest (from M4) ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Web Push (from M4) ──────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Backups ─────────────────────────────────────────────────────────────────
# Optional: age public key (age1…); when set, off-server copies are encrypted with it.
BACKUP_AGE_RECIPIENT=
# Optional: rclone destination for encrypted off-server copies, e.g. remote:bucket/path
BACKUP_REMOTE=

# ── Optional ────────────────────────────────────────────────────────────────
# LOG_LEVEL=info
